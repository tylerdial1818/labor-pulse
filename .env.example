# Copy to .env.local for local development.

NEXT_PUBLIC_APP_NAME="Client Analytics Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth-ready placeholders. Do not commit real secrets.
AUTH_SECRET="replace-with-strong-random-secret"
AUTH_TRUST_HOST=true

# Optional database/API targets for app-specific implementations.
DATABASE_URL="postgresql://user:password@localhost:5432/analytics_app"
ANALYTICS_API_BASE_URL="https://api.example.com"
ANALYTICS_API_KEY="replace-in-secret-manager"

# Deployment and observability.
NEXT_PUBLIC_ENVIRONMENT="local"
SENTRY_DSN=""
