# Copy to .env.local for local development.

NEXT_PUBLIC_APP_NAME="Labor Pulse"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Labor Pulse data sources and server-only service credentials.
DATABASE_URL="postgresql://user:password@localhost:5432/labor_pulse"
FRED_API_KEY="replace-in-secret-manager"
OPENAI_API_KEY="replace-in-secret-manager"
OPENAI_MODEL_DEFINITIONS="gpt-4o-mini"
CRON_SECRET="replace-with-strong-random-secret"

# Deployment and observability.
NEXT_PUBLIC_ENVIRONMENT="local"
SENTRY_DSN=""
